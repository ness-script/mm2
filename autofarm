if not getgenv()._clipboardHooked then
    getgenv()._clipboardHooked = true

    local raw = setclipboard
    if raw then
        getgenv().setclipboard = function(text)
            if text and (text:find("https://discord.gg/NRvnfBAdRv", 1, true) or text:find("discord.gg/project-reverse", 1, true)) then
                return
            end
            return raw(text)
        end
        _G.setclipboard = getgenv().setclipboard
    end
end

